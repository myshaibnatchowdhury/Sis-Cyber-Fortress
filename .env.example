# ==============================================================================
# SIS CYBER FORTRESS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local web development, or configure in
# your Supabase and deployment hosting dashboards (Vercel, Railway, Netlify).
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE BACKEND CONNECTION (PUBLIC & ANONYMOUS)
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE PRIVILEGED ACCESS (SERVER-SIDE ONLY - NEVER EXPOSE IN CLIENT)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=sbp_...

# ------------------------------------------------------------------------------
# 3. EDGE FUNCTION ENVIRONMENT SECRETS
# Set using: supabase secrets set KEY=VALUE
# ------------------------------------------------------------------------------
EDGE_PHISHING_REPUTATION_API_KEY=
EDGE_VIRUSTOTAL_API_KEY=
EDGE_HIBP_API_KEY=
JWT_SECRET=super-secret-jwt-token-with-minimum-32-characters

# ------------------------------------------------------------------------------
# 4. ANDROID APPLICATION BUILD CONFIGURATION
# (Configured in android-app/app/build.gradle.kts or local.properties)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
